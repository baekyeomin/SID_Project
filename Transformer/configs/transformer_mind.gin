# ============================================================
# Dataset
# ============================================================

# 사용자 클릭 history에서 최근 기사 최대 20개까지만 사용
NewsSequenceDataset.max_history_length = 20

# 클릭 history가 비어 있는 row는 학습/평가에서 제외
NewsSequenceDataset.drop_empty_history = True

# history/candidate SID, 후보 수, label, SID 중복 등을 검사
NewsSequenceDataset.validate_data = True


# ============================================================
# Semantic ID vocabulary size
# ============================================================

# MIND의 c1(category) 전체 code 개수
NewsEncoderDecoderTransformer.c1_vocab_size = 18

# MIND의 c2(event) codebook 크기
NewsEncoderDecoderTransformer.c2_vocab_size = 128

# MIND의 c3(residual semantic code) codebook 크기
NewsEncoderDecoderTransformer.c3_vocab_size = 512

# MIND의 c4(article discriminator) code 개수
# ※ 이 값은 MIND article_semantic_ids 기준 실제 c4 범위를 확인해서 넣어야 함
NewsEncoderDecoderTransformer.c4_vocab_size = <MIND_C4_VOCAB_SIZE>


# ============================================================
# Transformer architecture
# ============================================================

# Transformer 내부 embedding / hidden representation 차원
NewsEncoderDecoderTransformer.d_model = 384

# Multi-Head Attention의 head 개수
NewsEncoderDecoderTransformer.num_heads = 6

# Feed Forward Network 내부 hidden dimension
NewsEncoderDecoderTransformer.d_ff = 1024

# Encoder와 Decoder의 Transformer layer 개수
NewsEncoderDecoderTransformer.num_layers = 4

# 과적합 방지를 위한 dropout 비율
NewsEncoderDecoderTransformer.dropout_rate = 0.1

# history에서 기사 사이를 구분하기 위한 SEP token 사용
NewsEncoderDecoderTransformer.use_sep = True


# ============================================================
# Loss
# ============================================================

# positive candidate의 score가 negative보다 높도록 하는 preference loss 가중치
NewsTransformerLoss.lambda_preference = 1.0


# ============================================================
# Dataset paths
# ============================================================

# 1 positive + 4 negative로 전처리 완료된 MIND training dataset
train.train_path = "datasets/mind/train_sequences_1pos4neg.parquet"

# 기존 validation의 시간순 앞 50%를 사용한 validation dataset
train.validation_path = "datasets/mind/validation_sequences_1pos4neg_half.parquet"

# MIND Transformer checkpoint 및 학습 결과 저장 폴더
train.save_dir = "out/transformer/mind"


# ============================================================
# Training hyperparameters
# ============================================================

# 한 번의 parameter update에 사용하는 sample 수
train.batch_size = 128

# training dataset을 최대 30 epoch 학습
train.num_epochs = 30

# optimizer의 초기 learning rate
train.learning_rate = 0.0001

# 과적합 방지를 위한 weight decay
train.weight_decay = 0.01

# gradient exploding 방지를 위한 gradient norm 최대값
train.gradient_clip_norm = 1.0

# DataLoader worker process 수
train.num_workers = 0

# 실험 재현을 위한 random seed
train.seed = 42

# validation 성능이 5 epoch 연속 개선되지 않으면 학습 종료
train.early_stopping_patience = 5