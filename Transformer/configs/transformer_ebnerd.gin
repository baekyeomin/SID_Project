NewsSequenceDataset.max_history_length = 20 
NewsSequenceDataset.drop_empty_history = True 
NewsSequenceDataset.validate_data = True 

NewsEncoderDecoderTransformer.c1_vocab_size = 25
NewsEncoderDecoderTransformer.c2_vocab_size = 128
NewsEncoderDecoderTransformer.c3_vocab_size = 512 

NewsEncoderDecoderTransformer.c4_vocab_size = 28

NewsEncoderDecoderTransformer.d_model = 384
NewsEncoderDecoderTransformer.num_heads = 6

NewsEncoderDecoderTransformer.d_ff = 1024


NewsEncoderDecoderTransformer.num_layers = 4


NewsEncoderDecoderTransformer.dropout_rate = 0.1
NewsEncoderDecoderTransformer.use_sep = True

TransformerLoss.lambda_c1 = 1.0
TransformerLoss.lambda_c2 = 1.0
TransformerLoss.lambda_c3 = 1.0
TransformerLoss.lambda_c4 = 1.0

train.train_path = "datasets/ebnerd/train_sequences.parquet"
train.validation_path = "datasets/ebnerd/validation_sequences_half.parquet"
train.save_dir = "out/transformer/ebnerd"

train.batch_size = 128
train.num_epochs = 30
train.learning_rate = 0.0001
train.weight_decay = 0.01

train.gradient_clip_norm = 1.0
train.num_workers = 0
train.seed = 42
train.early_stopping_patience = 5